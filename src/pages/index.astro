---
import BaseLayout from '../layouts/BaseLayout.astro';

const experiences = [
	{
		date: '2025—present',
		role: 'Agentic AI Research Assistant',
		organization: 'Dynamic Optimization & RL Lab',
		location: 'Toronto, ON',
		description: 'Improving LLM evaluation for legal judgement.'
	},
	{
		date: '2023—present',
		role: 'Engineering & Artificial Intelligence',
		organization: 'University of Toronto',
		location: 'St. George campus',
		description: 'Learning, building, and researching at the intersection of software and AI.'
	}
];

const projects = [
	{
		title: 'forwardpass',
		description: 'Local AI server from my bedroom. Serving Qwen3.8-27B MTP Q4_K_M on an RTX 3090 through llama.cpp.',
		tags: ['ai', 'inference', 'quantization', 'local'],
		href: 'https://github.com/jakemaly/forwardpass',
	},
	{
		title: 'project demo',
		description: 'A visual home for the things I build for fun.',
		tags: ['design', 'software'],
		href: '#',
		media: '/project-placeholder.svg',
		mediaAlt: 'Abstract project placeholder'
	},
	{
		title: 'signal garden',
		description: 'A longer project description to test how a card handles more context, multiple lines, and a slower reading rhythm.',
		tags: ['web', 'interaction', 'prototype'],
		href: '#'
	},
	{
		title: 'medivue',
		description: 'Making complex information easier to see.',
		tags: ['health', 'data', 'frontend', 'team'],
		href: '#',
		media: '/project-placeholder.svg',
		mediaAlt: 'Abstract project placeholder'
	}
];
---

<BaseLayout>
	<header class="site-header">
		<div class="site-header__inner">
			<a href="#home" class="site-logo">jake<span>@</span>maly</a>
			<nav aria-label="Primary navigation">
				<a href="#projects">projects</a>
				<a href="#about">about</a>
			</nav>
		</div>
	</header>

	<main class="portfolio-shell">
		<section id="home" class="terminal-page" aria-labelledby="name">
			<div class="terminal-hero">
				<div class="hero-copy">
					<p class="terminal-prompt">jake@maly:~$ whoami</p>
					<h1 id="name">jake maly</h1>
					<p class="terminal-subtext">engineering + ai @ uoft</p>
					<div class="hero-actions">
						<a href="#projects" class="portfolio-button portfolio-button--primary">view work</a>
						<a href="mailto:jake@mail.utoronto.ca" class="portfolio-button portfolio-button--outline"><span class="nf-icon" aria-hidden="true">&#xf0e0;</span> email me</a>
						<a href="https://github.com/jakemaly" class="portfolio-button portfolio-button--outline"><span class="nf-icon" aria-hidden="true">&#xf09b;</span> github ↗</a>
						<a href="https://jakemaly.github.io/resume/" class="portfolio-button portfolio-button--warm"><span class="nf-icon" aria-hidden="true">&#xf15c;</span> resume ↗</a>
					</div>
				</div>
			</div>
		</section>

		<div is-="separator" direction-="horizontal" variant-="foreground2"></div>

		<section id="projects" class="portfolio-section" aria-labelledby="projects-heading">
			<p class="section-kicker">01 // projects</p>
			<h2 id="projects-heading">things I've made</h2>
			<div class="project-grid">
				{projects.map((project, index) => (
					<article class="project-card" box-="square">
						{project.media && (
							<a href={project.href} class="project-media">
								<img src={project.media} alt={project.mediaAlt} loading="lazy" />
							</a>
						)}
						<div class="project-card__body">
							<div class="project-title-row">
								<h3>{project.title}</h3>
								<span class="project-index">[{String(index + 1).padStart(2, '0')}]</span>
							</div>
							<p>{project.description}</p>
							<div class="project-tags">
								{project.tags.map((tag) => <span is-="badge" variant-="nord11" cap-="round">{tag}</span>)}
							</div>
							<a class="project-link" href={project.href}>
								{project.href.includes('github.com') && <span class="nf-icon" aria-hidden="true">&#xf09b;</span>}
								open project →
							</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section id="about" class="portfolio-section" aria-labelledby="about-heading">
			<p class="section-kicker">02 // about</p>
			<h2 id="about-heading">a curious person at a keyboard</h2>
			<div class="about-experience-grid">
				<p>
					I'm a student and research assistant at the University of Toronto. I like making
					software that feels clear, useful, and a little human — from AI research tools to
					things built late at night for fun.
				</p>
				<div class="experience-list">
					{experiences.map((experience) => (
						<article class="experience-entry">
							<div>
								<p class="experience-date">{experience.date}</p>
								<h3>{experience.role}</h3>
								<p class="experience-meta">{experience.organization} · {experience.location}</p>
								<p>{experience.description}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<p>© {new Date().getFullYear()} jake maly · built with curiosity &amp; caffeine</p>
	</footer>
</BaseLayout>
